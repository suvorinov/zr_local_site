# Корпоративный портал — пример настроек
# Скопируйте в .env и измените под себя

CORP_APP_TITLE=Корпоративный портал
CORP_ORG_NAME=ООО "Название компании"

# Путь к БД (относительно корня проекта)
CORP_DB_PATH=data/corp_site.db

# Каталоги с фонами и поздравлениями
CORP_BACKGROUND_DIR=app/static/backgrounds
CORP_GREETING_DIR=app/static/greetings

# Ротация поздравлений (сек)
CORP_ROTATION_SECONDS=60

# Ротация инфо-блоков, когда именинников нет (сек)
CORP_EMPTY_ROTATION_SECONDS=20

# Время ежедневной проверки дней рождений (ЧЧ:ММ)
CORP_CHECK_TIME=06:00

# Часовой пояс приложения (IANA-идентификатор)
CORP_TIMEZONE=Europe/Moscow

# Координаты для прогноза погоды (Москва по умолчанию)
CORP_WEATHER_LAT=55.7558
CORP_WEATHER_LON=37.6176

# Погода: интервал обновления кэша (мин, по умолчанию 60)
CORP_WEATHER_REFRESH_MINUTES=60
# Резервный источник погоды OpenWeatherMap (API-ключ, необязательно)
CORP_WEATHER_OPENWEATHERMAP_KEY=
# Аварийный источник wttr.in: город для запроса (по умолчанию Ryazan)
CORP_WEATHER_WTTR_CITY=Ryazan

# Новости ТАСС (RSS) для инфо-блока панели
CORP_NEWS_ENABLED=true
CORP_NEWS_FETCH_MINUTES=15
CORP_NEWS_MAX_ITEMS=6

# Скорость бегущей строки (пикселей в секунду, по умолчанию 40)
# Уменьшите для медленной строки (например, 20), увеличьте для быстрой (80)
CORP_TICKER_SPEED=40

# Учётные данные администратора (ОБЯЗАТЕЛЬНО задать!)
# Вариант 1 — пароль открытым текстом (не менее 8 символов):
CORP_ADMIN_USERNAME=admin
CORP_ADMIN_PASSWORD=CHANGE_ME_PLEASE

# Вариант 2 — bcrypt-хэш вместо открытого пароля (рекомендуется для прода):
# Сгенерировать:  python -c "import bcrypt;print(bcrypt.hashpw(b'ПАРОЛЬ',bcrypt.gensalt()).decode())"
# Тогда CORP_ADMIN_PASSWORD можно НЕ задавать / оставить пустым.
# CORP_ADMIN_PASSWORD_HASH=$2b$12$ABCDEF0123456789abcdefgAqRnxjvMH4pGITpWfW2Keq3k
